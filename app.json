{
  "expo": {
    "name": "SURF",
    "slug": "surf-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "surf-mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.tavemakers.surf",
      "usesAppleSignIn": true,
      "googleServicesFile": "./firebase/GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "사진을 촬영할 때 카메라를 사용합니다.",
        "NSPhotoLibraryUsageDescription": "사진을 등록할 때 사진 보관함을 사용합니다.",
        "UIBackgroundModes": ["remote-notification"]
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2E58FF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "site.tavesurf.mobile",
      "googleServicesFile": "./firebase/google-services.json",
      "permissions": ["android.permission.POST_NOTIFICATIONS"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withoutSplashIcon.cjs",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#12141c"
          }
        }
      ],
      "expo-apple-authentication",
      [
        "@react-native-firebase/app",
        {
          "ios": {
            "disableSPM": true
          }
        }
      ],
      "@react-native-firebase/messaging",
      [
        "@react-native-kakao/core",
        {
          "nativeAppKey": "7ad2c2815402f1fa3d0a2a662669e422",
          "android": {
            "authCodeHandlerActivity": true
          },
          "ios": {
            "handleKakaoOpenUrl": true
          }
        }
      ],
      "expo-font",
      "./plugins/withModularHeaders.cjs",
      "./plugins/withKakaoMavenRepo.cjs",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e2a71376-da4c-4d4f-9fa1-f3014e740f38"
      }
    }
  }
}
